{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "experimentalDecorators": false,
    "useDefineForClassFields": false,
    "isolatedModules": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src"]
}
